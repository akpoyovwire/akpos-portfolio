# Copy these into Vercel (Project -> Settings -> Environment Variables) and into .env.local.
# NEVER put a real value in this file, and NEVER start any of these names with VITE_.

# --- the AI ---
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- recording chats (server only) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_NEW_secret_key_here      # the SECRET key, not the publishable one

# --- the weekly email (server only) ---
RESEND_API_KEY=re_your_key_here
DIGEST_TO_EMAIL=the_email_you_signed_up_to_resend_with@example.com
# DIGEST_FROM="Mon IA <onboarding@resend.dev>"     # optional; this is the default
CRON_SECRET=a_long_random_string_you_make_up        # protects the weekly job from strangers
